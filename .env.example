# Sao chép thành .env khi chạy local. Không commit tệp .env thật.
SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=hoadon_database;encrypt=false
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=replace-with-local-database-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

APP_FRONTEND_URL=http://hoadon2er.local.vn
APP_BACKEND_URL=http://hoadon2er.local.vn
APP_CORS_ALLOWED_ORIGINS=http://hoadon2er.local.vn,http://hoadon2er.local.vn:8081
APP_UPLOAD_DIR=./uploads

# Dùng các giá trị ngẫu nhiên riêng cho local; không dùng lại secret production.
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ENCRYPTION_KEY=replace-with-a-random-encryption-key

# Chỉ cấu hình các tích hợp thực sự sử dụng ở môi trường local.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_BANK_LIST_KEY1=
PATVAN_UAT_CLIENT_ID=
PATVAN_UAT_CLIENT_SECRET=
PATVAN_UAT_CLIENT_MTT_ID=
PATVAN_UAT_CLIENT_MTT_SECRET=
PATVAN_UAT_CLIENT_CT_ID=
PATVAN_UAT_CLIENT_CT_SECRET=
